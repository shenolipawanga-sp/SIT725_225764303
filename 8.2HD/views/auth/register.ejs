<%- include('../partials/header', { user: null }) %>

<div class="row">
  <div class="col s12 m6 offset-m3">
    <div class="card">
      <div class="card-content">
        <span class="card-title">Create an account</span>

        <% if (error) { %>
          <div class="card-panel red lighten-4 red-text text-darken-4"><%= error %></div>
        <% } %>

        <form action="/auth/register" method="POST">
          <div class="input-field">
            <input id="email" name="email" type="email" required>
            <label for="email">Email</label>
          </div>
          <div class="input-field">
            <input id="password" name="password" type="password" minlength="8" required>
            <label for="password">Password (8 characters or more)</label>
          </div>
          <div class="input-field">
            <input id="confirmPassword" name="confirmPassword" type="password" required>
            <label for="confirmPassword">Confirm password</label>
          </div>
          <button class="btn teal darken-2" type="submit">Register</button>
        </form>
      </div>
      <div class="card-action">
        <a href="/auth/login">Already have an account? Sign in</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>